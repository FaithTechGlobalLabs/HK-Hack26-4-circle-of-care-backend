# Copy to .env and fill in.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
# Add your ngrok host here when testing with Twilio, e.g. abcd-1234.ngrok-free.app
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# Leave empty to use SQLite (db.sqlite3). For the Docker Postgres (docker compose up -d):
# DATABASE_URL=postgres://postgres:postgres@localhost:5434/neighbour
DATABASE_URL=

# AI provider: deepseek or anthropic
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Twilio WhatsApp Sandbox (Console > Messaging > Try it out > Send a WhatsApp message)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Turn off only for local testing without ngrok
TWILIO_VALIDATE_SIGNATURE=true

# Shared passcode volunteers type to open the request board. Empty = no passcode.
BOARD_PASSCODE=
